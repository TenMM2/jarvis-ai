# Copy this file to .env and fill in your own keys. Never commit the real .env.
#
# This project defaults to Google Gemini. Get a free key at
# https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional — only needed if you switch the default model to one of these
# providers (see ~/.openjarvis/config.toml -> [intelligence] default_model).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
