# Copy this file to .env and fill in your own keys. Never commit the real .env.
#
# This project defaults to Google Gemini. Get a free key at
# https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional — only needed if you switch the default model to one of these
# providers (see ~/.openjarvis/config.toml -> [intelligence] default_model).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides for the Gemini voice backends (if you use them instead
# of the local faster-whisper / Kokoro ones). Free-tier quota is per model.
GEMINI_STT_MODEL=
GEMINI_TTS_MODEL=

# Optional: Instagram (professional account) read-only tools. Token lasts ~60 days.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Optional: YouTube Data API key (free) for find_viral_videos. Just an API key.
YOUTUBE_API_KEY=

# Optional: least-privilege Google access when running `connect gmail`.
#   readonly        read-only Gmail/Calendar/Tasks
#   calendar-write  read-only mail, read+write Calendar
# Leave empty for the full scope set (needed to send mail / create events).
JARVIS_GOOGLE_SCOPES=
